NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEAR_ROOM_PASSWORD=
GEAR_ROOM_SESSION_SECRET=

# Optional public ID overrides: defaults are selected automatically for Preview/Production.
# Scope overrides to the matching Vercel environment. Leave blank to use defaults.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Server only. Never use a NEXT_PUBLIC_ prefix for the access token.
SQUARE_ACCESS_TOKEN=
# Close Nomads registration manually when the Square guest count reaches capacity.
NOMADS_REGISTRATION_PAUSED=false
